# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtuelle Umgebungen (werden lokal erzeugt, nie mitliefern)
.venv/
.venv-*/
venv/
env/

# Werkzeug-Zwischenspeicher
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Testabdeckung
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build-Artefakte (PyInstaller, setuptools)
build/
dist/
dist-probe/
# Vom Inno-Setup-Skript erzeugter Installer
dist-installer/
# Heruntergeladene Python-Laufzeitumgebung fuer den Installer (~67 MB).
# Wird von 'installer/python-laufzeit-holen.ps1' geholt, nie eingecheckt.
dist-python/
*.egg-info/

# Von der CI erzeugte Listen fuer pip-audit
abhaengigkeiten.txt
laufzeit-aufgeloest.txt

# ---------------------------------------------------------------------------
# Geheimnisse und persoenliche Einstellungen
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Nutzerdaten (Aufnahmen, Transkripte, Protokolle).
# Die Ordner werden beim Start automatisch angelegt und gehoeren deshalb
# gar nicht erst ins Repository - auch nicht als leere Platzhalter.
# ---------------------------------------------------------------------------
ausgabe/
aufnahmen/
arbeitsdaten/

# Sicherheitsnetz: Medien- und Protokolldateien gehoeren nie ins Repository,
# egal in welchem Ordner sie auftauchen.
*.mp3
*.mp4
*.m4a
*.wav
*.aac
*.flac
*.ogg
*.opus
*.wma
*.srt
*.vtt
*.log

# ---------------------------------------------------------------------------
# Editoren und Betriebssystem
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Rechnerspezifische Claude-Code-Skills
# ---------------------------------------------------------------------------
# '.claude/skills/' beschreibt, wie dieser eine Arbeitsplatz an GitHub kommt.
# Das ist von Rechner zu Rechner verschieden - wer regulaer an github.com
# angemeldet ist, braucht nichts davon. Versioniert wuerde die Datei andere
# Mitarbeitende in die Irre fuehren. CLAUDE.md bleibt versioniert.
.claude/skills/
.claude/settings.local.json
