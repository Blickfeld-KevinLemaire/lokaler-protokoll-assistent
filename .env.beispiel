# Vorlage fuer die Datei '.env' (kopieren und anpassen). Die echte '.env' gehoert
# nie ins Repository.

# Hugging-Face-Zugangstoken fuer die Sprechertrennung (pyannote). Die Lizenz des
# Modells muss mit dem zugehoerigen Konto einmal bestaetigt sein:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Benutzer, dem ./daten gehoert (Linux: id -u / id -g)
UID=1000
GID=1000

# cpu oder cuda (cuda nur zusammen mit docker-compose.gpu.yml)
PROTOKOLL_GERAET=cpu
PROTOKOLL_SPRACHE=de
PROTOKOLL_WHISPER_MODELL=large-v3-turbo
PROTOKOLL_OLLAMA_MODELL=qwen3.5:4b-q4_K_M
PROTOKOLL_SPRECHERTRENNUNG=1
PROTOKOLL_PROTOKOLL_ERSTELLEN=1

# So lange (Sekunden) muss eine Aufnahme unveraendert sein, bevor sie verarbeitet wird
PROTOKOLL_STABIL_SEKUNDEN=30

# Zusaetzliche Formate neben der Word-Datei: docx, md, txt, html, srt, vtt, json (kommagetrennt)
PROTOKOLL_EXPORT_FORMATE=

# Optional: Rueckmeldung an ein Fremdsystem/Geraet (HTTP-POST mit Dateiname, Status, Ordner)
PROTOKOLL_WEBHOOK_URL=
PROTOKOLL_WEBHOOK_TOKEN=
